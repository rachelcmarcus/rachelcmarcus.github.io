# 3. Import One Event Log File

This function reads one subject's raw event log, numbers the rows (mirroring
your `rowid_to_column(Still_Face, "Code")` step), and checks that the file
contains exactly one subject ID that matches the ID in the file name.

```{r import-function}
extract_id_from_filename <- function(filename) {

  id <- str_extract(basename(filename), "^\\d+")

  if (is.na(id)) {
    stop("Could not identify a subject ID from file: ", basename(filename))
  }

  id
}

import_event_log <- function(filename_full) {

  filename_short <- basename(filename_full)
  filename_id <- extract_id_from_filename(filename_short)

  data <- read_excel(filename_full) %>%
    as.data.frame()

  # Number every row so episode boundaries can be located by row position,
  # the same way `Code` was used in the draft.
  data <- data %>%
    tibble::rowid_to_column("Code") %>%
    mutate(ID = as.character(`Subject ID`))

  # Stop if the file mixes more than one subject ID, or the internal ID
  # doesn't match the ID in the file name -- either would silently mis-ID
  # a couple's data.
  internal_ids <- unique(data$ID)

  if (length(internal_ids) != 1) {
    stop(
      "File does not contain exactly one Subject ID: ", filename_short,
      ". Found: ", paste(internal_ids, collapse = ", ")
    )
  }

  if (internal_ids != filename_id) {
    stop(
      "File name ID (", filename_id, ") does not match internal Subject ID (",
      internal_ids, ") in file: ", filename_short
    )
  }

  # Stop if any non-marker Behavior isn't on the reference list -- protects
  # against typos, new codes, or a coding-scheme change going in unscored.
  observed_behaviors <- data %>%
    filter(!(Behavior %in% BOUNDARY_MARKERS)) %>%
    distinct(Subject, Behavior)

  unmapped <- observed_behaviors %>%
    anti_join(BEHAVIOR_REFERENCE, by = c("Subject", "Behavior"))

  if (nrow(unmapped) > 0) {
    stop(
      "Unrecognized Subject/Behavior combination(s) in file ", filename_short,
      ": ", paste(unmapped$Subject, unmapped$Behavior, sep = "/", collapse = "; "),
      ". Add to BEHAVIOR_REFERENCE or fix the coding before re-running."
    )
  }

  data
}
```

# 4. Identify Episode Anchors

This is the fixed-up version of your `Episodes_1`--`Episodes_4` chunks. Two
corrections from the draft:

- `bl_start` should be the **first** row of the file (baseline begins at the
  very start of coding), not the last -- the draft had `last(Code)`.
- Each anchor is now checked for existing (`stop()` if a marker is missing),
  the same way `process_single_warmth_file()` stops if second 6 is missing.

```{r episode-anchor-function}
get_episode_anchors <- function(data) {

  filename_note <- unique(data$ID)

  bl_start <- min(data$Code)
  reunion_end <- max(data$Code)

  no_infant_vocal <- data %>%
    filter(Behavior == "15 S NO INFANT VOCAL", Event_Type == "State start")

  if (nrow(no_infant_vocal) == 0) {
    stop("Could not find '15 S NO INFANT VOCAL' marker for ID: ", filename_note)
  }

  bl_end <- first(no_infant_vocal$Code)
  sf_start <- last(no_infant_vocal$Code)

  reunion_transition <- data %>%
    filter(Behavior == "REUNION TRANSITION NO EXPRESSION", Event_Type == "State start")

  if (nrow(reunion_transition) == 0) {
    stop("Could not find 'REUNION TRANSITION NO EXPRESSION' marker for ID: ", filename_note)
  }

  sf_end <- first(reunion_transition$Code)
  reunion_start <- last(reunion_transition$Code)

  anchors <- tibble(
    ID = filename_note,
    bl_start = bl_start, bl_end = bl_end,
    sf_start = sf_start, sf_end = sf_end,
    reunion_start = reunion_start, reunion_end = reunion_end
  )

  # Stop if the anchors aren't in increasing order -- a malformed or
  # re-ordered export would otherwise silently produce garbage episodes.
  anchor_sequence <- c(bl_start, bl_end, sf_start, sf_end, reunion_start, reunion_end)

  if (is.unsorted(anchor_sequence, strictly = FALSE)) {
    stop("Episode anchors are not in increasing order for ID: ", filename_note)
  }

  anchors
}
```

## Assign the `time_helper` episode variable

Same logic you started, turned into a function and applied with the anchors
found above. `time_helper` (1 = Baseline, 2 = Still Face, 3 = Reunion) is the
**episode** a row belongs to -- separate from the **epoch** terminology used
in `BEHAVIOR_REFERENCE` above, which refers to a behavioral coding stream, not
a time period.

```{r time-helper-function}
assign_time_helper <- function(data, anchors) {

  data %>%
    mutate(time_helper = case_when(
      Code >= anchors$bl_start & Code <= anchors$bl_end ~ 1,
      Code >= anchors$sf_start & Code <= anchors$sf_end ~ 2,
      Code >= anchors$reunion_start & Code <= anchors$reunion_end ~ 3,
      TRUE ~ NA_real_
    ))
}
```

Rows that fall outside all three ranges are the boundary marker rows
themselves (their start/stop events sit just outside the inclusive ranges by
design) -- not scored behavior, so `NA` here is expected and is dropped
naturally by the duration/count functions below, which always filter on a
specific `time_helper` value.

# 5. Duration, Count, and Overlap Functions

These three functions are the generic scoring engine -- the equivalent of
`process_warmth_files()` -- and get called once per row of `SCORE_SPEC` in
Section 6.

```{r scoring-functions}
# Total seconds a subject spent in one behavior during one episode.
# Duration_sf is only populated on "State start" rows (it holds that state's
# full duration), so State stop rows are excluded to avoid double-counting.
compute_duration <- function(data, subj, behavior, episode) {
  data %>%
    filter(Subject == subj, Behavior == behavior,
           Event_Type == "State start", time_helper == episode) %>%
    summarise(total = sum(Duration_sf)) %>%
    pull(total)
}

# Number of times a subject entered one behavior during one episode.
compute_count <- function(data, subj, behavior, episode) {
  data %>%
    filter(Subject == subj, Behavior == behavior,
           Event_Type == "State start", time_helper == episode) %>%
    nrow()
}

# Seconds during which two behaviors (e.g. mom talking/touching AND infant
# looking at mom) were both happening at once, for the dyadic variables.
compute_overlap_duration <- function(data, subject_a, behavior_a, subject_b, behavior_b, episode) {

  intervals_a <- data %>%
    filter(Subject == subject_a, Behavior == behavior_a,
           Event_Type == "State start", time_helper == episode) %>%
    transmute(start_a = Time_Relative_sf, end_a = Time_Relative_sf + Duration_sf)

  intervals_b <- data %>%
    filter(Subject == subject_b, Behavior == behavior_b,
           Event_Type == "State start", time_helper == episode) %>%
    transmute(start_b = Time_Relative_sf, end_b = Time_Relative_sf + Duration_sf)

  if (nrow(intervals_a) == 0 | nrow(intervals_b) == 0) {
    return(0)
  }

  # Compare every A interval against every B interval and sum the positive
  # overlaps (pmax(0, ...) zeroes out non-overlapping pairs).
  crossing(intervals_a, intervals_b) %>%
    mutate(overlap = pmax(0, pmin(end_a, end_b) - pmax(start_a, start_b))) %>%
    summarise(total = sum(overlap)) %>%
    pull(total)
}
```

# 6. Score Specification

