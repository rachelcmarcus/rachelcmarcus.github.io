# Writes each label into its column's "label" attribute -- this is the
# attribute haven::write_sav() reads to set the SPSS variable label on
# export (Section 10). Silently skips any name in VARIABLE_LABELS that
# isn't actually a column in the dataset, rather than stopping, since a
# label lagging behind a since-removed variable shouldn't block export.
apply_variable_labels <- function(dataset, labels) {
  for (var_name in names(labels)) {
    if (var_name %in% names(dataset)) {
      attr(dataset[[var_name]], "label") <- labels[[var_name]]
    }
  }
  dataset
}
