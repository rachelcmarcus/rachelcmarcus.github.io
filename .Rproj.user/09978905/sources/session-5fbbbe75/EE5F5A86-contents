# 7. Label the Raw Event Data, and Compute Scores

This is split into two functions, producing the two output datasets from
Section 1: a **raw** long-format dataset (one row per coded behavior instance,
episode already attached) and a **computed** wide dataset (one row per
subject, every score-sheet variable, with SPSS labels attached -- Section 6
builds those labels). Splitting labeling and scoring into two functions means
that if a proportion denominator or `tot` formula needs to change later
(Section 2 has several flagged), you can re-run just 7.2 against the saved
raw data -- no need to re-import and re-validate the original Excel files,
since the raw file stays in the same long shape 7.2 expects.

## 7.1 Label one subject's raw event data

Wraps Sections 3--4: import, validate behaviors, find anchors, assign
episodes. Returns one row per coded behavior instance for that subject, with
`time_helper` attached -- this is what gets stacked across subjects into
`SF_RAW` (Section 9) and saved directly as the raw file.

```{r label-raw-function}
import_and_label_one_subject <- function(filename_full) {

  data <- import_event_log(filename_full)
  anchors <- get_episode_anchors(data)
  data <- assign_time_helper(data, anchors)

  # Keep only the columns scoring actually needs. The original export has
  # several date/time columns (Date_Time_Absolute_dmy_hmsf, Time_Relative_hms,
  # etc.) that duplicate Time_Relative_sf/Duration_sf in a less convenient
  # form and don't save cleanly to every file format -- dropped here rather
  # than carried through as dead weight.
  data %>%
    select(ID, Code, Subject, Behavior, Event_Type, Time_Relative_sf, Duration_sf, time_helper)
}
```

## 7.2 Compute one subject's scores from labeled raw data

Takes one subject's labeled raw data (the output of 7.1) and computes every
`SCORE_SPEC` variable (Baseline/Still Face/Reunion), then the joint-attention
variables, the Total-across-episode sums, and every proportion. **Each block
below is commented with which score-sheet variables it creates and why** --
if a name needs to change and it's a proportion or a `tot` sum rather than a
plain duration/count, this is where to look (the right-hand side of each
`scores$<name> <-` line).

```{r compute-scores-function}
compute_scores_one_subject <- function(data) {

  subject_id <- unique(data$ID)

  # Compute every SCORE_SPEC variable (Section 6) with the generic engine
  # from Section 5 -- this creates every plain duration/count variable for
  # Baseline, Still Face, and Reunion.
  spec_values <- SCORE_SPEC %>%
    mutate(
      value = pmap_dbl(
        list(subject, behavior, episode, metric),
        function(subj, behavior, episode, metric) {
          if (metric == "duration") {
            compute_duration(data, subj, behavior, episode)
          } else {
            compute_count(data, subj, behavior, episode)
          }
        }
      )
    ) %>%
    select(var_name, value) %>%
    pivot_wider(names_from = var_name, values_from = value)

  scores <- tibble(ID = subject_id) %>%
    bind_cols(spec_values)

  # --- Proportions -----------------------------------------------------


  # --- Dyadic joint attention -------------------------------------------
  scores$v2sfbljntatn <- compute_overlap_duration(
    data, "Mother", "Mom Talking/Touching Infant", "Infant", "Looking at Mom", episode = 1
  )
  scores$v2sfrejntatn <- compute_overlap_duration(
    data, "Mother", "Mom Talking/Touching Infant", "Infant", "Looking at Mom", episode = 3
  )

  # --- TOTAL-ACROSS-EPISODES sums ---------------------------------------
  # "tot" = sum of whichever of Baseline/Still Face/Reunion apply to that
  # construct (see Section 6 -- most constructs skip Still Face or are Still
  # Face only, per the original score sheet's "NA" cells).

  scores$v2sftotnegvoc <- scores$v2sfblnegvoc + scores$v2sfsfnegvoc + scores$v2sfrenegvoc
  scores$v2sftotneuvoc <- scores$v2sfblneuvoc + scores$v2sfsfneuvoc + scores$v2sfreneuvoc
  scores$v2sftotposvoc <- scores$v2sfblposvoc + scores$v2sfsfposvoc + scores$v2sfreposvoc
  scores$v2sftotsilvoc <- scores$v2sfblsilvoc + scores$v2sfsfsilvoc + scores$v2sfresilvoc
  scores$v2sftotnegexp <- scores$v2sfblnegexp + scores$v2sfsfnegexp + scores$v2sfrenegexp
  scores$v2sftotneuexp <- scores$v2sfblneuexp + scores$v2sfsfneuexp + scores$v2sfreneuexp
  scores$v2sftotposexp <- scores$v2sfblposexp + scores$v2sfsfposexp + scores$v2sfreposexp
  scores$v2sftotyeslook <- scores$v2sfblyeslook + scores$v2sfreyeslook
  scores$v2sftotnotlook <- scores$v2sfblnotlook + scores$v2sfrenotlook
  scores$v2sftotnegaffH <- scores$v2sfblnegaffH + scores$v2sfrenegaffH
  scores$v2sftotnegaffL <- scores$v2sfblnegaffL + scores$v2sfrenegaffL
  scores$v2sftotneuaff <- scores$v2sfblneuaff + scores$v2sfreneuaff
  scores$v2sftotposaffL <- scores$v2sfblposaffL + scores$v2sfreposaffL
  scores$v2sftotposaffH <- scores$v2sfblposaffH + scores$v2sfreposaffH
  scores$v2sftottlktch <- scores$v2sfbltlktch + scores$v2sfretlktch
  scores$v2sftotnotlktch <- scores$v2sfblnotlktch + scores$v2sfrenotlktch
  scores$v2sftotjntatn <- scores$v2sfbljntatn + scores$v2sfrejntatn

  # --- PROPORTIONS ---------------------------------------------------------
  # -------- bl --------
  vocal_total_bl <- scores$v2sfblnegvoc + scores$v2sfblneuvoc + scores$v2sfblposvoc  # excludes silence
  scores$v2sfblnegvocprop <- scores$v2sfblnegvoc / vocal_total_bl
  scores$v2sfblposvocprop <- scores$v2sfblposvoc / vocal_total_bl
  expression_total_bl <- scores$v2sfblnegexp + scores$v2sfblneuexp + scores$v2sfblposexp
  scores$v2sfblnegexpprop <- scores$v2sfblnegexp / expression_total_bl
  scores$v2sfblposexpprop <- scores$v2sfblposexp / expression_total_bl
  gaze_total_bl <- scores$v2sfblyeslook + scores$v2sfblnotlook
  scores$v2sfblattprop <- scores$v2sfblyeslook / gaze_total_bl
  affect_total_bl <- scores$v2sfblnegaffH + scores$v2sfblnegaffL + scores$v2sfblneuaff + scores$v2sfblposaffL + scores$v2sfblposaffH
  scores$v2sfblnegaffprop <- (scores$v2sfblnegaffH + scores$v2sfblnegaffL) / affect_total_bl
  scores$v2sfblneuaffprop <- scores$v2sfblneuaff / affect_total_bl
  scores$v2sfblposaffprop <- (scores$v2sfblposaffL + scores$v2sfblposaffH) / affect_total_bl
  scores$v2sfblnegaffHprop <- scores$v2sfblnegaffH / affect_total_bl
  scores$v2sfblnegaffLprop <- scores$v2sfblnegaffL / affect_total_bl
  scores$v2sfblposaffHprop <- scores$v2sfblposaffH / affect_total_bl
  scores$v2sfblposaffLprop <- scores$v2sfblposaffL / affect_total_bl
  talktouch_total_bl <- scores$v2sfbltlktch + scores$v2sfblnotlktch
  scores$v2sfbltlktchprop <- scores$v2sfbltlktch / talktouch_total_bl
  scores$v2sfbljntatnprop <- scores$v2sfbljntatn / talktouch_total_bl

  # -------- sf --------
  vocal_total_sf <- scores$v2sfsfnegvoc + scores$v2sfsfneuvoc + scores$v2sfsfposvoc  # excludes silence
  scores$v2sfsfnegvocprop <- scores$v2sfsfnegvoc / vocal_total_sf
  scores$v2sfsfposvocprop <- scores$v2sfsfposvoc / vocal_total_sf
  expression_total_sf <- scores$v2sfsfnegexp + scores$v2sfsfneuexp + scores$v2sfsfposexp
  scores$v2sfsfnegexpprop <- scores$v2sfsfnegexp / expression_total_sf
  scores$v2sfsfposexpprop <- scores$v2sfsfposexp / expression_total_sf
  orientation_total_sf <- scores$v2sfsfobj + scores$v2sfsfpar
  scores$v2sfsfparprop <- scores$v2sfsfpar / orientation_total_sf

  # -------- re --------
  vocal_total_re <- scores$v2sfrenegvoc + scores$v2sfreneuvoc + scores$v2sfreposvoc  # excludes silence
  scores$v2sfrenegvocprop <- scores$v2sfrenegvoc / vocal_total_re
  scores$v2sfreposvocprop <- scores$v2sfreposvoc / vocal_total_re
  expression_total_re <- scores$v2sfrenegexp + scores$v2sfreneuexp + scores$v2sfreposexp
  scores$v2sfrenegexpprop <- scores$v2sfrenegexp / expression_total_re
  scores$v2sfreposexpprop <- scores$v2sfreposexp / expression_total_re
  gaze_total_re <- scores$v2sfreyeslook + scores$v2sfrenotlook
  scores$v2sfreattprop <- scores$v2sfreyeslook / gaze_total_re
  affect_total_re <- scores$v2sfrenegaffH + scores$v2sfrenegaffL + scores$v2sfreneuaff + scores$v2sfreposaffL + scores$v2sfreposaffH
  scores$v2sfrenegaffprop <- (scores$v2sfrenegaffH + scores$v2sfrenegaffL) / affect_total_re
  scores$v2sfreneuaffprop <- scores$v2sfreneuaff / affect_total_re
  scores$v2sfreposaffprop <- (scores$v2sfreposaffL + scores$v2sfreposaffH) / affect_total_re
  scores$v2sfrenegaffHprop <- scores$v2sfrenegaffH / affect_total_re
  scores$v2sfrenegaffLprop <- scores$v2sfrenegaffL / affect_total_re
  scores$v2sfreposaffHprop <- scores$v2sfreposaffH / affect_total_re
  scores$v2sfreposaffLprop <- scores$v2sfreposaffL / affect_total_re
  talktouch_total_re <- scores$v2sfretlktch + scores$v2sfrenotlktch
  scores$v2sfretlktchprop <- scores$v2sfretlktch / talktouch_total_re
  scores$v2sfrejntatnprop <- scores$v2sfrejntatn / talktouch_total_re

  # -------- tot --------
  vocal_total_tot <- scores$v2sftotnegvoc + scores$v2sftotneuvoc + scores$v2sftotposvoc  # excludes silence
  scores$v2sftotnegvocprop <- scores$v2sftotnegvoc / vocal_total_tot
  scores$v2sftotposvocprop <- scores$v2sftotposvoc / vocal_total_tot
  expression_total_tot <- scores$v2sftotnegexp + scores$v2sftotneuexp + scores$v2sftotposexp
  scores$v2sftotnegexpprop <- scores$v2sftotnegexp / expression_total_tot
  scores$v2sftotposexpprop <- scores$v2sftotposexp / expression_total_tot
  gaze_total_tot <- scores$v2sftotyeslook + scores$v2sftotnotlook
  scores$v2sftotattprop <- scores$v2sftotyeslook / gaze_total_tot
  affect_total_tot <- scores$v2sftotnegaffH + scores$v2sftotnegaffL + scores$v2sftotneuaff + scores$v2sftotposaffL + scores$v2sftotposaffH
  scores$v2sftotnegaffprop <- (scores$v2sftotnegaffH + scores$v2sftotnegaffL) / affect_total_tot
  scores$v2sftotneuaffprop <- scores$v2sftotneuaff / affect_total_tot
  scores$v2sftotposaffprop <- (scores$v2sftotposaffL + scores$v2sftotposaffH) / affect_total_tot
  scores$v2sftotnegaffHprop <- scores$v2sftotnegaffH / affect_total_tot
  scores$v2sftotnegaffLprop <- scores$v2sftotnegaffL / affect_total_tot
  scores$v2sftotposaffHprop <- scores$v2sftotposaffH / affect_total_tot
  scores$v2sftotposaffLprop <- scores$v2sftotposaffL / affect_total_tot
  talktouch_total_tot <- scores$v2sftottlktch + scores$v2sftotnotlktch
  scores$v2sftottlktchprop <- scores$v2sftottlktch / talktouch_total_tot
  scores$v2sftotjntatnprop <- scores$v2sftotjntatn / talktouch_total_tot
  # Convert 0/0 NaNs (an epoch with zero coded time) to proper missing.
  scores <- scores %>%
    mutate(across(where(is.numeric), ~ if_else(is.nan(.x), NA_real_, .x)))

  scores
}
```

# 8. Validate the Finished Wide Scores Dataset

Mirrors `validate_warmth_dataset()`: stops on duplicate IDs, and stops if any
proportion is outside the possible 0--1 range.

```{r validate-function}
validate_scores_dataset <- function(dataset) {

  duplicate_ids <- dataset %>%
    count(ID) %>%
    filter(n > 1)

  if (nrow(duplicate_ids) > 0) {
    stop("Scores dataset contains duplicate IDs: ", paste(duplicate_ids$ID, collapse = ", "))
  }

  proportion_vars <- names(dataset)[str_detect(names(dataset), "prop$")]

  invalid_proportions <- dataset %>%
    select(ID, all_of(proportion_vars)) %>%
    pivot_longer(-ID, names_to = "variable", values_to = "value") %>%
    filter(!is.na(value), value < 0 | value > 1)

  if (nrow(invalid_proportions) > 0) {
    stop(
      "Out-of-range proportion(s) found for ID(s): ",
      paste(unique(invalid_proportions$ID), collapse = ", ")
    )
  }

  message("Still Face scores: data-quality checks passed.")
}
```

# 9. Run the Pipeline Across All Subject Files

```{r process-all-subjects}
# Find every subject's event log export in the folder.
files_full <- list.files(
  path = PATH_EVENT_LOGS,
  pattern = "Event.?Logs\\.xlsx$",
  full.names = TRUE,
  recursive = TRUE,
  ignore.case = TRUE
)

if (length(files_full) == 0) {
  stop("No event log files found in: ", PATH_EVENT_LOGS)
}

# RAW layer (Section 7.1): import + validate + label every subject, stacked
# into one long dataset -- one row per coded behavior instance. This is the
# raw output as-is (Section 10 saves it directly) and it's also what
# Section 7.2 scores from below, so it can be fed straight back into scoring
# later without re-importing the original Excel files.
SF_RAW <- map_dfr(files_full, import_and_label_one_subject) %>%
  arrange(ID, Code)

# COMPUTED layer (Section 7.2): score every subject from their labeled raw
# data, one subject at a time.
SF_SCORES <- SF_RAW %>%
  group_split(ID) %>%
  map_dfr(compute_scores_one_subject) %>%
  arrange(ID)

validate_scores_dataset(SF_SCORES)
```

# 10. Save Both Datasets

Two files, two locations (Section 1), so the intermediate/audit data and the
final analysis data can't be confused for each other. `SF_RAW` stays long
(one row per coded behavior instance) so it can be fed straight back into
`compute_scores_one_subject()` later without re-importing the original Excel
files. Variable labels (Section 6) are applied to the computed dataset only,
just before export -- SPSS shows them in Variable View alongside the short
variable names.

```{r export-scores}
if (!dir.exists(dirname(PATH_OUTPUT_RAW))) {
  stop("Output folder does not exist: ", dirname(PATH_OUTPUT_RAW))
}

if (!dir.exists(dirname(PATH_OUTPUT_COMPUTED))) {
  stop("Output folder does not exist: ", dirname(PATH_OUTPUT_COMPUTED))
}

SF_SCORES_LABELED <- apply_variable_labels(SF_SCORES, VARIABLE_LABELS)

write_sav(SF_RAW, PATH_OUTPUT_RAW)
write_sav(SF_SCORES_LABELED, PATH_OUTPUT_COMPUTED)
```

