\">neutral</span><span class=\"cl-e01aea69\"> </span><span class=\"cl-e01aea6b\">expression</span></p></td><td class=\"cl-e01d2789\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea5e\">bl</span><span class=\"cl-e01aea6c\">neu</span><span class=\"cl-e01aea72\">exp</span></p></td><td class=\"cl-e01d2789\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea5f\">sf</span><span class=\"cl-e01aea6c\">neu</span><span class=\"cl-e01aea72\">exp</span></p></td><td class=\"cl-e01d2789\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea60\">re</span><span class=\"cl-e01aea6c\">neu</span><span class=\"cl-e01aea72\">exp</span></p></td><td class=\"cl-e01d2789\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea68\">tot</span><span class=\"cl-e01aea6c\">neu</span><span class=\"cl-e01aea72\">exp</span></p></td></tr><tr style=\"overflow-wrap:break-word;\"><td class=\"cl-e01d2788\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea69\">Duration smile/</span><span class=\"cl-e01aea6a\">positive</span><span class=\"cl-e01aea69\"> </span><span class=\"cl-e01aea6b\">expression</span></p></td><td class=\"cl-e01d2789\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea5e\">bl</span><span class=\"cl-e01aea6c\">pos</span><span class=\"cl-e01aea72\">exp</span></p></td><td class=\"cl-e01d2789\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea5f\">sf</span><span class=\"cl-e01aea6c\">pos</span><span class=\"cl-e01aea72\">exp</span></p></td><td class=\"cl-e01d2789\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea60\">re</span><span class=\"cl-e01aea6c\">pos</span><span class=\"cl-e01aea72\">exp</span></p></td><td class=\"cl-e01d2789\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea68\">tot</span><span class=\"cl-e01aea6c\">pos</span><span class=\"cl-e01aea72\">exp</span></p></td></tr><tr style=\"overflow-wrap:break-word;\"><td class=\"cl-e01d277f\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea69\">Proportion of </span><span class=\"cl-e01aea54\">episode</span><span class=\"cl-e01aea69\"> crying/</span><span class=\"cl-e01aea6a\">negative</span><span class=\"cl-e01aea69\"> </span><span class=\"cl-e01aea6b\">vocal</span></p></td><td class=\"cl-e01d2780\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea5e\">bl</span><span class=\"cl-e01aea6c\">neg</span><span class=\"cl-e01aea72\">voc</span><span class=\"cl-e01aea54\">epi</span></p></td><td class=\"cl-e01d2780\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea5f\">sf</span><span class=\"cl-e01aea6c\">neg</span><span class=\"cl-e01aea72\">voc</span><span class=\"cl-e01aea54\">epi</span></p></td><td class=\"cl-e01d2780\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea60\">re</span><span class=\"cl-e01aea6c\">neg</span><span class=\"cl-e01aea72\">voc</span><span class=\"cl-e01aea54\">epi</span></p></td><td class=\"cl-e01d2780\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea68\">tot</span><span class=\"cl-e01aea6c\">neg</span><span class=\"cl-e01aea72\">voc</span><span class=\"cl-e01aea54\">epi</span></p></td></tr><tr style=\"overflow-wrap:break-word;\"><td class=\"cl-e01d277f\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea69\">Proportion of </span><span class=\"cl-e01aea6b\">vocal</span><span class=\"cl-e01aea69\">s that are </span><span class=\"cl-e01aea6a\">negative</span></p></td><td class=\"cl-e01d2780\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea5e\">bl</span><span class=\"cl-e01aea6c\">neg</span><span class=\"cl-e01aea72\">voc</span><span class=\"cl-e01aea54\">prop</span></p></td><td class=\"cl-e01d2780\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea5f\">sf</span><span class=\"cl-e01aea6c\">neg</span><span class=\"cl-e01aea72\">voc</span><span class=\"cl-e01aea54\">prop</span></p></td><td class=\"cl-e01d2780\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea60\">re</span><span class=\"cl-e01aea6c\">neg</span><span class=\"cl-e01aea72\">voc</span><span class=\"cl-e01aea54\">prop</span></p></td><td class=\"cl-e01d2780\"><p class=\"cl-e01d1626\"><span class=\"cl-e01aea68\">tot</span><span class=\"cl-e01aea6c\">neg</span><span class=\"cl-e01aea72\">voc</span><span class=\"cl-e01aea54\">prop</span></p></td></tr></tbody></table></div>\n```\n\n:::\n:::\n\n\n\n::: {.cell}\n\n```{.r .cell-code  code-summary=\"data example code\"}\n# ── Build the Annotated Raw-Data Example ──────────────────────────────────────\n# Restrict the raw event log to two short windows so the rendered example remains readable\ndemo <- raw %>%\n  filter(Time_Relative_sf <= 2.12 | (Time_Relative_sf >= 119.995 & Time_Relative_sf <= 120.02)) %>%\n  transmute(\n    Segment  = if_else(Time_Relative_sf <= 2.12, \"Opening of Baseline\", \"Baseline \\u2192 Still Face transition\"),\n    `Time (s)`     = round(Time_Relative_sf, 3),\n    `Duration (s)` = round(Duration_sf, 3),\n    Subject,\n    Behavior,\n    `Event Type` = Event_Type\n  )\n\nft_example <- flextable(demo) %>%\n  merge_v(j = \"Segment\") %>%\n  theme_box() %>%\n  set_table_properties(layout = \"fixed\") %>%\n  width(j = \"Segment\", width = 1.1) %>%\n  width(j = \"Time (s)\", width = 0.85) %>%\n  width(j = \"Duration (s)\", width = 0.9) %>%\n  width(j = \"Subject\", width = 0.65) %>%\n  width(j = \"Behavior\", width = 2.2) %>%\n  width(j = \"Event Type\", width = 0.8) %>%\n  fontsize(size = 10, part = \"all\") %>%\n  bold(part = \"header\") %>%\n  align(j = c(\"Time (s)\", \"Duration (s)\"), align = \"right\", part = \"all\") %>%\n  font(j = \"Behavior\", fontname = \"Consolas\") %>%\n  color(i = ~ `Event Type` == \"State start\", j = \"Event Type\", color = \"#117733\") %>%\n  color(i = ~ `Event Type` == \"State stop\",  j = \"Event Type\", color = \"#882255\") %>%\n  bold(i = ~ grepl(\"^15 S|^BASELINE|^REUNION\", Behavior), j = \"Behavior\") %>%\n  hline(i = 8, border = fp_border(color = \"#999999\", width = 1.5))\n```\n:::\n\n\n\n::: {.cell}\n\n```{.r .cell-code  code-summary=\"data dictionary code\"}\n# ── Build and Format the Variable Dictionary ──────────────────────────────────\n# Recreate the sample dictionary and color-code variable-name components to make the naming system visually explicit\nvar_dict <- tibble::tribble(\n  ~Domain,  ~Variable,                                      ~Baseline,        ~`Still Face`,     ~Reunion,          ~Total,\n  \"Infant\", \"Duration crying/negative vocal\",                \"blnegvoc\",       \"sfnegvoc\",        \"renegvoc\",        \"totnegvoc\",\n  \"Infant\", \"Duration neutral vocal\",                        \"blneuvoc\",       \"sfneuvoc\",        \"reneuvoc\",        \"totneuvoc\",\n  \"Infant\", \"Duration silent vocal\",                         \"blsilvoc\",       \"sfsilvoc\",        \"resilvoc\",        \"totsilvoc\",\n  \"Infant\", \"Duration laughing/positive vocal\",              \"blposvoc\",       \"sfposvoc\",        \"reposvoc\",        \"totposvoc\",\n  \"Infant\", \"Duration frown/negative expression\",            \"blnegexp\",       \"sfnegexp\",        \"renegexp\",        \"totnegexp\",\n  \"Infant\", \"Duration neutral expression\",                   \"blneuexp\",       \"sfneuexp\",        \"reneuexp\",        \"totneuexp\",\n  \"Infant\", \"Duration smile/positive expression\",            \"blposexp\",       \"sfposexp\",        \"reposexp\",        \"totposexp\",\n  \"Infant\", \"Proportion of episode crying/negative vocal\",   \"blnegvocepi\",    \"sfnegvocepi\",     \"renegvocepi\",     \"totnegvocepi\",\n  \"Infant\", \"Proportion of vocals that are negative\",        \"blnegvocprop\",   \"sfnegvocprop\",    \"renegvocprop\",    \"totnegvocprop\"\n)\n\nprefix_colors <- c(bl = \"#332288\", sf = \"#88CCEE\", re = \"#44AA99\", tot = \"#117733\")\nroot1_words   <- c(\"neg\",\"neu\",\"sil\",\"pos\",\"yes\",\"not\",\"att\",\"tlk\",\"jnt\",\"obj\",\"par\",\"comf\",\"esc\")\nroot1_color   <- \"#882255\"\nroot2_colors  <- c(lktch = \"#88CCEE\", look = \"#CC6677\", voc = \"#CC6677\", exp = \"#CC6677\",\n                    tch = \"#332288\", atn = \"#44AA99\", aff = \"#AA4499\", end = \"#CC6677\")\n\nmatch_first <- function(rest, candidates) {\n  candidates <- candidates[order(-nchar(candidates))]\n  for (cand in candidates) if (startsWith(rest, cand)) return(cand)\n  NA_character_\n}\n\nsegment_var <- function(x) {\n  if (is.na(x) || x %in% c(\"n/a\", \"\")) return(data.frame(text = x, color = \"black\", bold = TRUE))\n  prefix <- match_first(x, names(prefix_colors))\n  rest   <- sub(paste0(\"^\", prefix), \"\", x)\n  root1  <- match_first(rest, root1_words)\n  rest2  <- if (!is.na(root1)) sub(paste0(\"^\", root1), \"\", rest) else rest\n  root2  <- match_first(rest2, names(root2_colors))\n  suffix <- if (!is.na(root2)) sub(paste0(\"^\", root2), \"\", rest2) else rest2\n  segs <- data.frame(text = prefix, color = prefix_colors[[prefix]], bold = TRUE)\n  if (!is.na(root1)) segs <- rbind(segs, data.frame(text = root1, color = root1_color, bold = TRUE))\n  if (!is.na(root2)) segs <- rbind(segs, data.frame(text = root2, color = root2_colors[[root2]], bold = TRUE))\n  if (nzchar(suffix)) segs <- rbind(segs, data.frame(text = suffix, color = \"black\", bold = TRUE))\n  segs\n}\n\ndesc_word_patterns <- list(\n  list(pattern = \"negative\",   color = root1_color,           bold = FALSE),\n  list(pattern = \"neutral\",    color = root1_color,           bold = FALSE),\n  list(pattern = \"silent\",     color = root1_color,           bold = FALSE),\n  list(pattern = \"positive\",   color = root1_color,           bold = FALSE),\n  list(pattern = \"vocal\",      color = root2_colors[[\"voc\"]], bold = FALSE),\n  list(pattern = \"expression\", color = root2_colors[[\"exp\"]], bold = FALSE),\n  list(pattern = \"episode\",    color = \"black\",               bold = TRUE)\n)\n\nsegment_desc <- function(text) {\n  matches <- list()\n  for (p in desc_word_patterns) {\n    locs <- gregexpr(p$pattern, text, fixed = TRUE)[[1]]\n    if (locs[1] == -1) next\n    lens <- attr(locs, \"match.length\")\n    for (k in seq_along(locs)) {\n      matches[[length(matches) + 1]] <- list(start = locs[k], end = locs[k] + lens[k] - 1,\n                                               color = p$color, bold = p$bold)\n    }\n  }\n  if (length(matches) == 0) return(data.frame(text = text, color = \"black\", bold = FALSE))\n  matches <- matches[order(sapply(matches, `[[`, \"start\"))]\n  segs <- data.frame(text = character(0), color = character(0), bold = logical(0))\n  cursor <- 1\n  for (m in matches) {\n    if (m$start > cursor) segs <- rbind(segs, data.frame(text = substr(text, cursor, m$start - 1), color = \"black\", bold = FALSE))\n    segs <- rbind(segs, data.frame(text = substr(text, m$start, m$end), color = m$color, bold = m$bold))\n    cursor <- m$end + 1\n  }\n  if (cursor <= nchar(text)) segs <- rbind(segs, data.frame(text = substr(text, cursor, nchar(text)), color = \"black\", bold = FALSE))\n  segs\n}\n\napply_segments <- function(ft, i, j, segs) {\n  chunks <- lapply(seq_len(nrow(segs)), function(k) {\n    as_chunk(segs$text[k], props = fp_text(color = segs$color[k], bold = segs$bold[k]))\n  })\n  mk_par(ft, i = i, j = j, value = do.call(as_paragraph, chunks))  # Mk_par, not compose — see below\n}\n\nft_dictionary <- flextable(var_dict) %>%\n  merge_v(j = \"Domain\") %>%\n  theme_box() %>%\n  autofit() %>%\n  set_table_properties(layout = \"fixed\") %>%\n  width(j = \"Domain\", width = 0.6) %>%\n  width(j = \"Variable\", width = 2.3) %>%\n  width(j = c(\"Baseline\",\"Still Face\",\"Reunion\",\"Total\"), width = 1.1) %>%\n  fontsize(size = 10, part = \"all\") %>%\n  bold(part = \"header\") %>%\n  color(j = \"Baseline\",    color = prefix_colors[[\"bl\"]],  part = \"header\") %>%\n  color(j = \"Still Face\",  color = prefix_colors[[\"sf\"]],  part = \"header\") %>%\n  color(j = \"Reunion\",     color = prefix_colors[[\"re\"]],  part = \"header\") %>%\n  color(j = \"Total\",       color = prefix_colors[[\"tot\"]], part = \"header\")\n\nvar_cols <- c(\"Baseline\", \"Still Face\", \"Reunion\", \"Total\")\nfor (i in seq_len(nrow(var_dict))) {\n  ft_dictionary <- apply_segments(ft_dictionary, i, \"Variable\", segment_desc(var_dict$Variable[i]))\n  for (col in var_cols) {\n    ft_dictionary <- apply_segments(ft_dictionary, i, col, segment_var(var_dict[[col]][i]))\n  }\n}\n```\n:::\n\n",
